---
import { getPieces } from '../lib/collection.js';
/** "In this room": the room's works as a miniature line hang, true ratios, one line. A show passes its own works and label. */
const { artist = null, pieces: given = null, current = null, label = 'In this room' } = Astro.props;
const pieces = given ?? getPieces(artist);
const here = (p) => current === (p.key ?? p.id);
---
<nav class="strip" aria-label={label}>
  <p class="small muted">{label}</p>
  <ol>
    {pieces.map((p) => (
      <li class:list={{ here: here(p) }}>
        <a href={p.href} aria-current={here(p) ? 'page' : undefined}>
          {p.image
            ? <img src={p.image.src} width={p.image.width} height={p.image.height} alt={p.title} loading="lazy" decoding="async" style={`aspect-ratio:${p.ratio}`} />
            : <span class="hole" style={`aspect-ratio:${p.ratio}`}></span>}
          <span class="small">{p.catNo}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>
<style>
  .strip ol { display: flex; gap: 24px; margin-top: 12px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: thin; }
  .strip li { flex: none; }
  .strip a { display: grid; gap: 6px; justify-items: start; }
  .strip img, .strip .hole { height: 56px; width: auto; display: block; }
  .strip .hole { outline: 1px dashed var(--muted); outline-offset: -1px; }
  .strip li.here img, .strip li.here .hole { box-shadow: 0 4px 0 -2px var(--wall), 0 4px 0 0 var(--ink); }
  .strip li.here .small { font-weight: 600; }
  .strip a:hover .small { text-decoration: underline; text-underline-offset: 0.2em; }
  .strip a:focus-visible { outline: none; }
  .strip a:focus-visible img { outline: 2px solid var(--ink); outline-offset: 4px; }
  @media (min-width: 900px) { .strip img, .strip .hole { height: 72px; } .strip ol { overflow: visible; flex-wrap: wrap; } }
</style>
